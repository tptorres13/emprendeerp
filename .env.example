# Copy to .env for local development without Docker. Never commit .env.
DJANGO_SETTINGS_MODULE=config.settings.dev
DJANGO_DEBUG=true
DJANGO_SECRET_KEY=change-me
DATABASE_URL=postgres://postgres:postgres@localhost:5432/erp
EMAIL_URL=consolemail://
DEFAULT_FROM_EMAIL=Emprende <no-reply@localhost>

# Production only (Railway / Render / VPS):
# DJANGO_SETTINGS_MODULE=config.settings.prod
# DJANGO_ALLOWED_HOSTS=mi-app.example.com
# DJANGO_CSRF_TRUSTED_ORIGINS=https://mi-app.example.com
# EMAIL_URL=smtp+tls://usuario:clave@smtp.proveedor.com:587
# ADMIN_URL=un-path-dificil-de-adivinar/
# WEB_CONCURRENCY=3
